# MySQL is the production repository. SQLite is permitted only in tests.
DATABASE_URL=mysql+pymysql://optimizer_user:change_me@127.0.0.1:3306/llm_optimizer
LLAMA_SERVER_URL=http://127.0.0.1:9931
OLLAMA_URL=http://127.0.0.1:11434
REQUEST_TIMEOUT_SECONDS=180
LOG_LEVEL=INFO
# Optional local physical-meter export JSON, for example:
# {"source":"wall meter", "cumulative_joules":12345.6}
ORBIT_ENERGY_METER_READING_PATH=hardware/meter_export.json
ENERGY_METER_READING_PATH=hardware/meter_export.json
# RAM safety reserve (MiB) preserved for OS and other applications during admission
ORBIT_SAFETY_RESERVE_MB=512
# Keep live chat response bodies out of JSONL/MySQL telemetry by default.
# Set true only when local data-governance approval permits retention.
ORBIT_RETAIN_LIVE_RESPONSE_TEXT=false
